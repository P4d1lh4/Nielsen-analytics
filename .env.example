# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# --- Database (Postgres) — required ---
DATABASE_URL=postgresql://user:pass@localhost:5433/ux_audit?schema=public

# --- Redis (BullMQ) — optional, defaults to redis://127.0.0.1:6379 ---
REDIS_URL=redis://127.0.0.1:6379

# --- Clerk auth (server) — CLERK_SECRET_KEY required ---
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Only needed if you use the Clerk webhook (/api/webhook/clerk)
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- S3 / MinIO storage (worker) — private bucket, presigned URLs ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rootadmin
S3_SECRET_KEY=rootpassword
S3_BUCKET_NAME=ux-audit-bucket
# Host-reachable endpoint used ONLY to sign screenshot URLs (MinIO split-horizon)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- LLM engine ---
# agent-sdk (Claude plan, default) | api (pay-per-token, needs AI_API_KEY)
AUDIT_ENGINE=agent-sdk
AUDIT_MODEL=claude-sonnet-4-6
AI_API_KEY=

# --- Server / worker tuning (optional) ---
PORT=3000
WORKER_CONCURRENCY=2
# CORS allowlist (comma-separated origins). Unset = no cross-origin access.
CORS_ORIGIN=
# Max POST /api/audit requests per user per 5 min (default 10)
AUDIT_RATE_LIMIT=10

# Set to 1 to force JSON logs (auto-on when NODE_ENV=production)
LOG_JSON=
